<mxfile host="app.diagrams.net" modified="2026-04-27T00:00:00.000Z" agent="ClaudeCode" version="24.7.17" type="device">
  <diagram name="Padrões de Ingestão Bronze" id="bronze-patterns">
    <mxGraphModel dx="1422" dy="811" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Padrões de Ingestão Bronze (PySpark + Iceberg)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Padrão A — CDC por hash (delta dataframe)&#10;Tabelas: auth_user, auth_userprofile, student_courseaccessrole, student_courseenrollment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="420" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p1d1" value="1. Calcular SHA1(CONCAT_WS('||', col1, col2, ...)) em SQL na fonte (MySQL)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1d2" value="2. read_data_from_sql(query) — JDBC Spark" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1d3" value="3. add_ingestion_metadata_column() → ingestion_date, source_name" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1d4" value="4. Ler estado actual da tabela target (dedup por id, último ingestion_date)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1d5" value="5. get_delta_dataframe(src, tgt):&#10;LEFT JOIN src ⋈ tgt ON id&#10;WHERE tgt.id IS NULL OR src.row_hash &#x2260; tgt.row_hash" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p1d6" value="6. .write.format('iceberg').mode('append')" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1d7" value="7. validate_table_that_delete_lines() — alerta de IDs ausentes na fonte" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1d8" value="8. update_ctrl_table() → bronze&lt;env&gt;.audit.pipeline_run_ctrl" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p1note" value="✓ Captura de UPDATE+INSERT, ignora linhas inalteradas&#10;✓ Sem dependência de coluna timestamp na fonte&#10;✗ Não captura DELETEs (o validate só alerta)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;strokeColor=#6c8ebf;fillColor=#e8f0ff;spacingLeft=8;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Padrão B — Janela incremental por created/modified&#10;Tabelas: certificates_generatedcertificate, course_overviews_courseoverview, grades_persistentcoursegrade, organizations_organization, student_userattribute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="490" y="100" width="420" height="700" as="geometry" />
        </mxCell>
        <mxCell id="p2d1" value="1. start_date = get_max_timestamp_for_table()&#10;Lê pipeline_run_ctrl ou devolve '1900-01-01' na primeira execução" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="510" y="170" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2d2" value="2. Query JDBC com filtro:&#10;WHERE created &#x2265; start_date OR modified &#x2265; start_date" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="510" y="240" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2d3" value="3. add_ingestion_metadata_column()" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="510" y="305" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2d4" value="4. .write.format('iceberg').mode('append')&#10;Tabelas particionadas por days(ingestion_date)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="510" y="350" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2d5" value="5. validate_ingestion_values() — distinct count na target" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="510" y="415" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2d6" value="6. update_ctrl_table()" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="510" y="460" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p2note" value="✓ Eficiente em volume — só puxa registos novos da fonte&#10;✓ Pode capturar deltas grandes em backfill (1900-01-01)&#10;✗ Pressupõe que created/modified são fiáveis na fonte&#10;✗ Pode ingerir o mesmo registo várias vezes — silver/gold deduplicam" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;strokeColor=#82b366;fillColor=#eef7e8;spacingLeft=8;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="510" y="510" width="380" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Padrão C — Snapshot único (one-shot)&#10;Tabela: organizations_historicalorganization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="940" y="100" width="420" height="380" as="geometry" />
        </mxCell>
        <mxCell id="p3d1" value="1. Verifica se start_date == FIXED_START_DATE (1900-01-01)&#10;→ se não, sai imediatamente" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="960" y="170" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3d2" value="2. Lê toda a tabela history em bloco" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3d3" value="3. Append único + update_ctrl_table" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;strokeColor=none;fillColor=#FFFFFF;spacingLeft=8" vertex="1" parent="1">
          <mxGeometry x="960" y="290" width="380" height="35" as="geometry" />
        </mxCell>
        <mxCell id="p3note" value="Usado para tabela de história organizacional do Open edX&#10;que serve apenas para construir o histórico SCD2 inicial em&#10;dim_organization (gold).&#10;A partir daí o pipeline silver/gold passa a usar a tabela&#10;regular (organizations_organization) para versionamento futuro." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=2;strokeColor=#d6b656;fillColor=#fffbe8;spacingLeft=8;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="960" y="335" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="Tabela de Auditoria&#10;&lt;layer&gt;&lt;env&gt;.audit.pipeline_run_ctrl&#10;&#10;Schema:&#10;  pipeline       STRING  ('entidades')&#10;  table_name     STRING&#10;  last_execution_ts TIMESTAMP&#10;  number_of_records INT&#10;&#10;Função: marca de água para incrementais e contagem por execução." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10" vertex="1" parent="1">
          <mxGeometry x="940" y="510" width="420" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
